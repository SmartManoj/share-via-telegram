{
  "manifest_version": 3,
  "name": "Share via Telegram (URL only)",
  "version": "1.16.1",
  "description": "Share the current page, link or image URL via Telegram, without title or trailing slash",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_icon": "icon128.png", "default_title": "Share Page via Telegram" },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "tabs"]
}
